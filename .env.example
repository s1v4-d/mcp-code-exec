# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Weather API Configuration (OpenWeatherMap)
OPEN_WEATHER_API_KEY=your-openweather-api-key-here

# RAG Configuration
RAG_INDEX_PATH=data/rag_index

# PostgreSQL Configuration (for postgres-mcp MCP server)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mcp_demo

# Postgres MCP Code-Mode (used by servers/postgres_mcp)
PG_HOST=localhost
PG_PORT=5432
PG_DB=mcp_demo
PG_USER=postgres
PG_PASSWORD=postgres

# Code Execution Settings
CODE_EXEC_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# UI Settings
API_BASE_URL=http://localhost:8000
